{
  "name": "aurora-cronicas-da-fenda",
  "version": "30.7.0",
  "private": true,
  "description": "Aurora — Crônicas da Fenda: jogo web (PC) empacotado como app Android com Capacitor.",
  "type": "module",
  "scripts": {
    "montar": "node ferramentas/montar.mjs",
    "verificar": "node ferramentas/montar.mjs --verificar",
    "sincronizar": "npm run montar && cap sync android",
    "apk": "bash ferramentas/gerar-apk.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
